# New API 二开 · 国内加速版 Dockerfile(适用于阿里云/国内 ECS,解决 build 慢)
#
# 用法(服务器 build):
#   docker build -f Dockerfile.cn -t new-api-gallery:latest .
#
# 推荐:把你【阿里云个人镜像加速器】(ECS 控制台 → 容器镜像服务里获取,
#   形如 https://<id>.mirror.aliyuncs.com)传进去,基础镜像拉取最快最稳:
#   docker build -f Dockerfile.cn --build-arg REGISTRY=<你的加速器> -t new-api-gallery:latest .
#
# 慢的三处,本文件都做了加速:
#   1) 基础镜像(oven/bun、golang、debian)→ 走 ${REGISTRY} 镜像源(默认 docker.m.daocloud.io,可 --build-arg 覆盖)
#   2) bun install(npm 依赖)→ BUN_CONFIG_REGISTRY=npmmirror
#   3) go mod download(Go 模块)→ GOPROXY=goproxy.cn
#
# 说明:首次 build 仍要拉基础层(比直连官方快很多);之后 build 命中 Docker 层缓存,重建很快。

# 全局默认值(均可被 --build-arg 覆盖)
ARG REGISTRY=docker.m.daocloud.io
ARG BUN_REGISTRY=https://registry.npmmirror.com
ARG GO_PROXY=https://goproxy.cn,direct

# ---- 阶段 1:编前端 ----
ARG REGISTRY
FROM ${REGISTRY}/oven/bun:1.4.0 AS builder
# 阶段内重新声明 ARG,否则 BUN_REGISTRY 在该阶段内为空(ARG 不跨阶段继承)
ARG BUN_REGISTRY
WORKDIR /build/web
COPY web/package.json web/bun.lock ./
ENV BUN_CONFIG_REGISTRY=${BUN_REGISTRY}
RUN bun install --frozen-lockfile
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

# ---- 阶段 2:编后端(内嵌前端 dist)----
ARG REGISTRY
FROM ${REGISTRY}/golang:1.26.10-alpine AS builder2
ARG GO_PROXY
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc
ENV GOPROXY=${GO_PROXY}

WORKDIR /build
ADD go.mod go.sum ./
# relaykit / tokenkit 是 go.mod 里 replace 引用的本地子模块,需先提供其 go.mod
ADD relaykit/go.mod ./relaykit/go.mod
ADD tokenkit/go.mod ./tokenkit/go.mod
# BuildKit 缓存挂载:模块缓存持久化,go mod download 命中后秒过(不重复下依赖)
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
COPY --from=builder /build/web/dist ./web/dist
# ============ go build(含 PGO 自愈)============
# 坑的来源:-pgo 的值是 shell 先求值、再把结果交给 go build 的。
#   $(go list -m -f '{{.Dir}}' github.com/Calcium-Ion/moejs) 只有在 moejs 源码
#   【已经落在 /go/pkg/mod 里】时才返回路径;没下载时返回空串 → 拼出来就是
#   "/default.pgo" → go build 报 preprofile: error opening profile: /default.pgo。
# 为什么会没下载:上面那条 `go mod download` 挂了 BuildKit cache mount,模块写进
#   缓存卷而不是镜像层。于是只要 go.mod 没变,这条 RUN 就命中【层缓存】被整段跳过;
#   而缓存卷一旦被 docker builder prune / docker system prune / 磁盘清理清掉,
#   求值那一刻 moejs 就不在 → 必炸。这是纯「Docker 缓存状态」问题,与代码无关,
#   所以改代码后第一次 build 就踩上了。
# 处理:不再赌缓存。这里先自检模块在不在,不在就补下载;补完仍拿不到就退化成
#   -pgo=off(仅少一点编译期优化,功能与产物体积基本无差别),保证任何缓存状态下都能编出来。
# 两个 cache mount 仍都挂上:
#   /go/pkg/mod           —— 模块缓存(与上面 go mod download 共用同一 target)
#   /root/.cache/go-build —— 编译缓存持久化,二次起 go build 走增量
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    moddir="$(go list -m -f '{{.Dir}}' github.com/Calcium-Ion/moejs 2>/dev/null || true)"; \
    if [ -z "$moddir" ] || [ ! -f "$moddir/default.pgo" ]; then \
        echo ">>> moejs 不在模块缓存中,补下载…"; \
        go mod download github.com/Calcium-Ion/moejs || true; \
        moddir="$(go list -m -f '{{.Dir}}' github.com/Calcium-Ion/moejs 2>/dev/null || true)"; \
    fi; \
    pgoflag="-pgo=off"; \
    if [ -n "$moddir" ] && [ -f "$moddir/default.pgo" ]; then \
        pgoflag="-pgo=$moddir/default.pgo"; \
    else \
        echo ">>> 警告: 取不到 moejs/default.pgo,本次改用 -pgo=off 构建(功能不受影响)"; \
    fi; \
    echo ">>> PGO 参数: $pgoflag"; \
    go build $pgoflag -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

# ---- 阶段 3:运行时 ----
ARG REGISTRY
FROM ${REGISTRY}/debian:bookworm-slim
# apt 走国内源:直接覆盖 sources 配置(bookworm-slim 默认用 deb822 的 debian.sources)。
# 关键:必须用 http://(官方 debian 源即 http)。用 https:// 时,slim 镜像里
# ca-certificates 尚未生效,apt 对 https 源 TLS 校验不过 → apt-get update exit 100。
# 组件只留 main(ca-certificates/tzdata/libasan8/wget 全在 main),降低 404 风险。
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/*.list 2>/dev/null || true; \
    printf '%s\n' \
        'deb http://mirrors.aliyun.com/debian/ bookworm main' \
        > /etc/apt/sources.list; \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates
COPY --from=builder2 /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]

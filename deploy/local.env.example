# ============================================================================
# 本地开发 .env 模板
# 复制为 deploy/.env（或项目根 .env）仅供本地开发使用。
# 与线上 .env 的唯一区别：SQL_DSN / REDIS_CONN_STRING 指向本地容器，口令可随意。
# 其余业务配置（如 SESSION_SECRET / CRYPT_KEY）本地开发随便填 64 位 hex 即可。
# ============================================================================

# --- 基础设施口令（本地开发随意）---
POSTGRES_PASSWORD=localdev
REDIS_PASSWORD=localdev

# --- 指向本地 PostgreSQL（docker 起的 postgres:15，端口映射到 5432）---
SQL_DSN=postgresql://postgres:localdev@localhost:5432/new-api

# --- 指向本地 Redis ---
REDIS_CONN_STRING=redis://:localdev@localhost:6379

# --- 应用配置（本地随意）---
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TZ=Asia/Shanghai
PORT=3000
ERROR_LOG_ENABLED=true
DEFAULT_LANGUAGE=zh-CN

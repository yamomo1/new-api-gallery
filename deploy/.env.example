# New API 二开部署环境变量模板
# 复制为 .env 后填写。用 deploy.sh 会自动生成随机口令;手动部署请把 CHANGE_ME 全部替换。
# 生成随机值:  openssl rand -hex 32

# --- 基础设施口令(被 docker-compose 变量插值使用) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- New API 应用配置 ---
# 密码必须与上方 POSTGRES_PASSWORD / REDIS_PASSWORD 保持一致
SQL_DSN=postgresql://root:CHANGE_ME@postgres:5432/new-api
REDIS_CONN_STRING=redis://:CHANGE_ME@redis:6379
SESSION_SECRET=CHANGE_ME_64_HEX
# CRYPT_KEY 用于加解密存储的 API Key(建议 32 字节 / 64 hex),务必固定且保密
CRYPT_KEY=CHANGE_ME_64_HEX
TZ=Asia/Shanghai
PORT=3000
ERROR_LOG_ENABLED=true
DEFAULT_LANGUAGE=zh-CN
